+void t_cose_crypto_secure_zero(struct q_useful_buf buffer)
+{
+    volatile uint8_t *bytes = (volatile uint8_t *)buffer.ptr;
+    for(size_t index = 0; index < buffer.len; index++) {
+        bytes[index] = 0;
+    }
+}
