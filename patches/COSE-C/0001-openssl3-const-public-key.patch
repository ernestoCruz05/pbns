From 1d9203766190201828557d944f2817d32b5bb832 Mon Sep 17 00:00:00 2001
From: PBNS Research Artifact <pbns@example.invalid>
Date: Mon, 27 Jul 2026 00:00:00 +0000
Subject: [PATCH] Fix OpenSSL 3 public-key const correctness

OpenSSL 3 returns a const EC_KEY from EVP_PKEY_get0_EC_KEY. Preserve that
qualification; no protocol or cryptographic behavior changes.
---
 src/openssl.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/openssl.cpp b/src/openssl.cpp
index 3d996bd..2fcfef4 100644
--- a/src/openssl.cpp
+++ b/src/openssl.cpp
@@ -2004,7 +2004,7 @@ bool ECDH_ComputeSecret(COSE *pMessage,
 		switch (type) {
 			case EVP_PKEY_EC: {
 				EC_KEY *peckeyPrivate = EC_KEY_new();
-				EC_KEY *peckeyPublic = EVP_PKEY_get0_EC_KEY(evpPublic);
+				const EC_KEY *peckeyPublic = EVP_PKEY_get0_EC_KEY(evpPublic);
 				EC_KEY_set_group(
 					peckeyPrivate, EC_KEY_get0_group(peckeyPublic));
 				CHECK_CONDITION(EC_KEY_generate_key(peckeyPrivate) == 1,
-- 
