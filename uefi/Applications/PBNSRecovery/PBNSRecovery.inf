## @file
# PBNS RAM-only recovery application.
#
# SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = PBNSRecovery
  FILE_GUID                      = 44ed573e-d0f8-4119-87c7-a4478f99ee77
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = UefiMain

[Sources]
  PBNSRecovery.c

[Packages]
  MdePkg/MdePkg.dec
  CryptoPkg/CryptoPkg.dec
  pbns/PbnsPkg.dec

[LibraryClasses]
  BaseMemoryLib
  MbedTlsLib
  PbnsCoreLib
  PbnsRecoveryClientLib
  PbnsRecoveryServiceLib
  PbnsTlsTransportLib
  PbnsUefiPlatformLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib
  UefiRuntimeServicesTableLib

[Guids]
  gEfiGlobalVariableGuid
  gPbnsBootConfigGuid

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -I$(WORKSPACE)/CryptoPkg/Library/MbedTlsLib/Include -I$(WORKSPACE)/CryptoPkg/Library/MbedTlsLib/mbedtls/include -std=c17 -Wextra -Wconversion -Wsign-conversion -Wshadow -Wvla -Wcast-qual -Wpointer-arith -Wstrict-prototypes -Wdouble-promotion -Wwrite-strings -Wno-discarded-qualifiers -Wno-unused-parameter -Wno-missing-prototypes
