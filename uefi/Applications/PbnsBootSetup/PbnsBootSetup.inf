## @file
# Explicit PBNS launcher and recovery boot setup utility.
#
# SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = PbnsBootSetup
  FILE_GUID                      = 44e1717d-9da8-428b-babb-5584ae508584
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = UefiMain

[Sources]
  PbnsBootSetup.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  pbns/PbnsPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DevicePathLib
  MemoryAllocationLib
  PbnsBootConfigLib
  UefiApplicationEntryPoint
  UefiBootManagerLib
  UefiLib

[Protocols]
  gEfiLoadedImageProtocolGuid

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -std=c17 -Wextra -Wconversion -Wsign-conversion -Wshadow -Wvla -Wcast-qual -Wpointer-arith -Wstrict-prototypes -Wdouble-promotion -Wwrite-strings -Wno-discarded-qualifiers -Wno-unused-parameter -Wno-missing-prototypes
