## @file
# Bounded EK certificate evidence from the standard TCG NV index.
#
# SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = PbnsTpmEkCertificateLib
  FILE_GUID                      = 4e49d84f-d380-455e-944b-a6ece74462c7
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.1
  LIBRARY_CLASS                  = PbnsTpmEkCertificateLib

[Sources]
  PbnsTpmEkCertificateLib.c

[Packages]
  MdePkg/MdePkg.dec
  SecurityPkg/SecurityPkg.dec
  pbns/PbnsPkg.dec

[LibraryClasses]
  BaseMemoryLib
  Tpm2CommandLib

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -std=c17 -Wextra -Wconversion -Wsign-conversion -Wshadow -Wvla -Wcast-qual -Wpointer-arith -Wmissing-prototypes -Wstrict-prototypes -Wdouble-promotion -Wwrite-strings
