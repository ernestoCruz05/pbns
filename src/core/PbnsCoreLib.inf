## @file
# Portable PBNS core library.
#
# SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = PbnsCoreLib
  FILE_GUID                      = 4fea3a43-a4b8-4b03-bf40-256cbc7e1991
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 0.1
  LIBRARY_CLASS                  = PbnsCoreLib

[Sources]
  anti_rollback.c
  attestation.c
  attestation_run.c
  attestation_receipt.c
  attestation_upload.c
  attestation_wire.c
  boot_config.c
  broker.c
  cobs.c
  crc32c.c
  crypto.c
  encrypt.c
  enrollment.c
  enrollment_wire.c
  enrollment_baseline.c
  controlled_baseline.c
  inventory.c
  frame.c
  identity.c
  launcher.c
  measured_boot.c
  object.c
  random.c
  recovery_assurance.c
  recovery_service_adapter.c
  recovery_live.c
  recovery_manifest.c
  recovery_request.c
  recovery_stream.c
  record_reader.c
  status.c
  stream.c
  tpm_profile.c
  trusted_time.c

[Packages]
  MdePkg/MdePkg.dec
  pbns/PbnsPkg.dec

[LibraryClasses]
  PbnsQcborLib
  Tss2MuLib

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -I$(WORKSPACE)/pbns/uefi/Library/Tss2Compat -I$(WORKSPACE)/pbns/.deps/tpm2-tss/include -std=c17 -Wextra -Wconversion -Wsign-conversion -Wshadow -Wvla -Wcast-qual -Wpointer-arith -Wmissing-prototypes -Wstrict-prototypes -Wdouble-promotion -Wwrite-strings
